{
  "name": "canva-axi",
  "version": "0.1.0",
  "description": "AXI-compliant CLI for Canva designs via Canva API — agent-ergonomic slideshow/design ops. Spec axi/1.0-2026-07.",
  "type": "module",
  "bin": {
    "canva-axi": "bin/canva-axi.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "skill:gen": "node scripts/gen-skill.mjs",
    "skill:check": "node scripts/gen-skill.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardaatahan/canva-axi.git"
  },
  "keywords": [
    "axi",
    "canva",
    "cli",
    "agents"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ardaatahan/canva-axi/issues"
  },
  "homepage": "https://github.com/ardaatahan/canva-axi#readme",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
